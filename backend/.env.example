# ==========================================
# MLA 多学助手 - 环境变量配置
# 复制此文件为 .env 并修改对应值
# ==========================================

# 应用配置
APP_NAME=MLA
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key

# 数据库 (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://mla:mla123@localhost:5432/mla_db
DATABASE_URL_SYNC=postgresql://mla:mla123@localhost:5432/mla_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Chroma 向量数据库 (本地持久化)
CHROMA_PERSIST_DIR=./chroma_data

# OpenAI API 配置 (用于 Embedding 和后续 LLM 调用)
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# 文本切片配置
CHUNK_SIZE=512
CHUNK_OVERLAP=50
