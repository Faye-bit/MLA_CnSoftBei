# ==========================================
# MLA 多学助手 - 环境变量配置
# 复制此文件为 .env 并修改对应值
# ==========================================

# 应用配置
APP_NAME=MLA
APP_VERSION=0.1.0
DEBUG=true

# 数据库 (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://mla:mla123@localhost:5432/mla_db

# Chroma 向量数据库 (本地持久化)
CHROMA_PERSIST_DIR=./chroma_data

# ==========================================
# LLM 大语言模型配置 (用于对话、资源生成等)
# 支持所有兼容 OpenAI 接口的模型服务
# ==========================================
# DeepSeek 示例:
#   LLM_API_KEY=sk-your-deepseek-key
#   LLM_API_BASE=https://api.deepseek.com
#   LLM_MODEL=deepseek-chat
#
# 智谱 GLM 示例:
#   LLM_API_KEY=your-zhipu-key
#   LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-4
#
# OpenAI 示例:
#   LLM_API_KEY=sk-your-openai-key
#   LLM_API_BASE=https://api.openai.com/v1
#   LLM_MODEL=gpt-4o

LLM_API_KEY=sk-your-llm-key-here
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ==========================================
# Embedding 向量模型配置 (用于知识库检索)
# 需要模型支持 embeddings API 接口
# ==========================================
# 方案一: OpenAI (text-embedding-3-small, 便宜且质量好)
#   EMBEDDING_API_KEY=sk-your-openai-key
#   EMBEDDING_API_BASE=https://api.openai.com/v1
#   EMBEDDING_MODEL=text-embedding-3-small
#
# 方案二: 本地 Ollama (免费, 无需联网)
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_API_BASE=http://localhost:11434/v1
#   EMBEDDING_MODEL=bge-m3
#
# 方案三: 智谱 (GLM embedding)
#   EMBEDDING_API_KEY=your-zhipu-key
#   EMBEDDING_API_BASE=https://open.bigmodel.cn/api/paas/v4
#   EMBEDDING_MODEL=embedding-3

EMBEDDING_API_KEY=sk-your-embedding-key-here
EMBEDDING_API_BASE=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ==========================================
# 文件上传配置
# ==========================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50

# 文本切片配置
CHUNK_SIZE=512
CHUNK_OVERLAP=50
